{
  "name": "keli-sensing-agent",
  "version": "1.0.0",
  "description": "Multi-System AI Agent for Robotics Market Intelligence & Outreach - Keli Sensing",
  "main": "src/server.js",
  "scripts": {
    "build": "npm --prefix frontend install && npm --prefix frontend run build && rm -rf dist public && cp -r frontend/dist ./dist && cp -r frontend/dist ./public",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "backup": "node scripts/backup_database.js",
    "backup:fast": "node scripts/backup_database.js --fast",
    "backup:auth": "node scripts/backup_database.js --schema=neon_auth",
    "backup:resilient": "node scripts/backup_resilient.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:e2e": "playwright test -c e2e/playwright.config.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@upstash/redis": "^1.37.0",
    "axios": "^1.6.0",
    "bcryptjs": "^3.0.3",
    "chalk": "^4.1.2",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.2",
    "csv-writer": "^1.6.0",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.4.1",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "node-fetch": "^2.7.0",
    "nodemailer": "10.0.13",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.21.0",
    "razorpay": "^2.9.8",
    "socks": "^2.8.10",
    "validator": "^13.11.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": "22.x"
  }
}

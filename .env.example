# ============================================================
# LEADER AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git.
# ============================================================

# ── OpenAI (LLM + Embeddings) ────────────────────────────────
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o                  # Optional: defaults to gpt-4o

# ── Apollo.io (Lead Enrichment) ──────────────────────────────
APOLLO_API_KEY=your-apollo-api-key

# ── SMTP (Email Outreach) ────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password          # Gmail: use App Password, not account password
SMTP_FROM_NAME=Leader
SMTP_FROM_EMAIL=your-email@gmail.com

# ── MongoDB Atlas ────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Leader

# ── Pipeline Settings ────────────────────────────────────────
PORT=3001
MAX_COMPANIES_PER_RUN=100
MAX_CONTACTS_PER_COMPANY=3
OUTREACH_DAILY_EMAIL_LIMIT=200
OUTREACH_DELAY_BETWEEN_EMAILS_MS=3000
FORCE_SEND_MOCK_EMAILS=false
ENABLE_AB_TESTING=false

# ── Scraping Settings ─────────────────────────────────────────
SCRAPING_DELAY_MS=2000
MAX_CONCURRENT_SCRAPERS=3
USE_HEADLESS_BROWSER=true

# ── Scoring Thresholds ───────────────────────────────────────
HIGH_PRIORITY_SCORE=75
MEDIUM_PRIORITY_SCORE=50

# ── Google Places API ────────────────────────────────────────
GOOGLE_API_KEY=AIzaSy...

# ── Vite Frontend (local dev only) ───────────────────────────
VITE_API_URL=http://localhost:3001/api
VITE_CRAWLER_API_URL=http://localhost:3001/api/crawler

# ── Redis (Upstash — serverless Redis) ───────────────────────
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ── JWT Auth ─────────────────────────────────────────────────
# Generate with: openssl rand -hex 32   (the server refuses to start without a real value)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── Google OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# ── Frontend URL (email links + OAuth redirect) ───────────────
# Local dev:
FRONTEND_URL=http://localhost:5174
# Production: set this to your Vercel frontend URL, e.g.:
# FRONTEND_URL=https://leader-frontend.vercel.app

# ── CORS ─────────────────────────────────────────────────────
# Optional: restrict CORS to a specific origin in production
# CORS_ORIGIN=https://leader-frontend.vercel.app

# ── Unified.to (Social Media Integration) ────────────────────
UNIFIED_API_KEY=your-unified-api-key
UNIFIED_WORKSPACE_ID=your-workspace-id
UNIFIED_WORKSPACE_SECRET=your-workspace-secret
UNIFIED_BASE_URL=https://api.unified.to

# ── Cloud SQL (Google Cloud PostgreSQL) — In-Build Database only ────────────
# MongoDB Atlas remains unchanged for all other features.
# Instance: sigma-current-497209-i6:us-central1:leader
CLOUD_SQL_HOST=34.9.35.25
CLOUD_SQL_PORT=5432
CLOUD_SQL_DB=doott_new
CLOUD_SQL_SCHEMA=public
CLOUD_SQL_TABLE=usa_business_data
CLOUD_SQL_USER=postgres
CLOUD_SQL_PASSWORD=your_cloud_sql_postgres_password_here
# Uncomment below for local plain Postgres (disables SSL):
# CLOUD_SQL_SSL=false


# ── Required by the current code (added by security audit) ─────────────────────
# Neon Postgres (lead database). Pooler URL for queries, direct URL for pgvector.
NEON_DATABASE_URL=postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
# NEON_DIRECT_URL=
NEON_SCHEMA=final
# NEON_TABLE=
# Comma-separated emails allowed to use platform-admin features
ADMIN_EMAIL=
BACKEND_URL=http://localhost:3001

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email verifier service (VPS)
DOOTT_VERIFIER_URL=
DOOTT_API_KEY=
# VERIFIER_VPS_URL=
# VERIFIER_VPS_API_KEY=
ENABLE_LOCAL_SMTP_PROBES=false
# SMTP_HELO_DOMAIN=
# Max rows per bulk verification request (default 10000)
# VERIFY_MAX_BATCH_ROWS=10000
# MILLIONVERIFIER_API_KEY=

# Lead-data providers / messaging (optional features)
# HUNTER_API_KEY=
# PROXYCURL_API_KEY=
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_SEARCH_CX=
# HUGGINGFACE_TOKEN=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=
# TWILIO_WHATSAPP_FROM=

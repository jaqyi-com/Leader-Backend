{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "src/public/**"
    }
  },
  "rewrites": [
    {
      "source": "/api-docs",
      "destination": "/api/index.js"
    },
    {
      "source": "/api-docs.html",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/pricing",
      "destination": "/pricing/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/app-shell.html"
    }
  ]
}

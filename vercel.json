{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{src/public/**,src/counts/phoneGeo.json.gz}"
    }
  },
  "rewrites": [
    {
      "source": "/api-docs",
      "destination": "/api/index.js"
    },
    {
      "source": "/api-docs.html",
      "destination": "/api/index.js"
    },
    {
      "source": "/mcp",
      "destination": "/api/index.js"
    },
    {
      "source": "/oauth/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/.well-known/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/pricing",
      "destination": "/pricing/index.html"
    },
    {
      "source": "/claude",
      "destination": "/claude/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/app-shell.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/refresh-counts",
      "schedule": "30 20 * * *"
    }
  ]
}
